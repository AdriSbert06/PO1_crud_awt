<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Biblioteca</title>
    <link rel="stylesheet" href="styles.css">
</head>

<body>

    <header>
        <h1>📚 Mi Biblioteca</h1>
        <p>Encuentra tu próximo libro favorito</p>
    </header>

    <nav>
        <a href="index.html">Inici</a>
        <a href="#libros">Llibres</a>
        <a href="login.html">Iniciar sessió</a>
    </nav>

    <main>
        <h2>Llibres destacats</h2>

        <section class="libros" id="libros">

            <div class="libro">
                <h3>Don Quijote</h3>
                <p>Miguel de Cervantes</p>
                <p>Clásico de la literatura española.</p>
                <button>Ver libro</button>
            </div>

            <div class="libro">
                <h3>Cien años de soledad</h3>
                <p>Gabriel García Márquez</p>
                <p>Una historia sobre la familia Buendía.</p>
                <button>Ver libro</button>
            </div>

            <div class="libro">
                <h3>1984</h3>
                <p>George Orwell</p>
                <p>Una novela distópica muy conocida.</p>
                <button>Ver libro</button>
            </div>

        </section>
    </main>

    <footer>
        <p>© 2026 Mi Librería</p>
    </footer>

</body>
</html>
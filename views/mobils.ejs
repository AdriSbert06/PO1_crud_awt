<!DOCTYPE html>
<html lang="ca">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mòbils</title>

    <link rel="stylesheet" href="/styles.css">
</head>

<body>

    <main class="productes-llista">

        <h1>Mòbils</h1>

        <ul>
            <% mobils.forEach(mobil => { %>

                <li>
                    <div class="producte-info">

                        <h2>
                            <%= mobil.marca %> <%= mobil.model %>
                        </h2>

                        <p>
                            <strong>Processador:</strong>
                            <%= mobil.processador %>
                        </p>

                        <p>
                            <strong>Memòria RAM:</strong>
                            <%= mobil.memoriaRAM %>
                        </p>

                        <p>
                            <strong>Emmagatzematge:</strong>
                            <%= mobil.emmagatzematge %>
                        </p>

                        <p class="preu">
                            <strong>Preu:</strong>
                            <%= mobil.preu %> €
                        </p>

                        <p>
                            <strong>Disponibilitat:</strong>

                            <% if (mobil.disponible) { %>
                                <span>Disponible</span>
                            <% } else { %>
                                <span>No disponible</span>
                            <% } %>
                        </p>

                    </div>

                    <div class="producte-accions">

                        <a href="/mobils">Veure</a>

                        <button type="button">
                            Editar
                        </button>

                        <button type="button" class="btn-eliminar">
                            Eliminar
                        </button>

                    </div>
                </li>

            <% }) %>
        </ul>

        <a href="/" class="tornar">Tornar</a>

    </main>

</body>

</html>
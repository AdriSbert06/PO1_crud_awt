<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Benvingut</title>
    <link rel="stylesheet" type="text/css" href="/styles.css">
</head>
<body>
    <header>
        <h1>Gestió de Productes per <%= user.name %>!</h1>
        <h2><%- htmlMessage %></h2>
    </header>
    <main>
        <section>
            <h2>Llista de Llibres</h2>
            <ul class="book-list">
                <% data.books.forEach(book => { %>
                    <li class="book-item">
                        <strong><%= book.name %></strong>
                        <span>Categoria: <%= book.category %></span>
                        <span>Preu: €<%= book.price %></span>
                    </li>
                <% }) %>
            </ul>
        </section>
    </main>
</body>
</html>
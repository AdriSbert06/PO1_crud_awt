<!DOCTYPE html>
<html lang="ca">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edita ordinador</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <main class="container">
        <section class="form-container">
            <h1>Editar ordinador: <%= ordinador.marca %> <%= ordinador.model %></h1>

            <form action="/ordinadors/<%= ordinador.id %>?_method=PUT" method="POST">
                <label for="marca">Marca:</label>
                <input type="text" id="marca" name="marca" value="<%= ordinador.marca %>" required>

                <label for="model">Model:</label>
                <input type="text" id="model" name="model" value="<%= ordinador.model %>" required>

                <label for="processador">Processador:</label>
                <input type="text" id="processador" name="processador" value="<%= ordinador.processador %>" required>

                <label for="memoriaRAM">Memòria RAM:</label>
                <input type="text" id="memoriaRAM" name="memoriaRAM" value="<%= ordinador.memoriaRAM %>" required>

                <label for="emmagatzematge">Emmagatzematge:</label>
                <input type="text" id="emmagatzematge" name="emmagatzematge" value="<%= ordinador.emmagatzematge %>" required>

                <label for="preu">Preu (€):</label>
                <input type="number" id="preu" name="preu" value="<%= ordinador.preu %>" min="0" step="0.01" required>

                <label for="disponible">Disponibilitat:</label>
                <select id="disponible" name="disponible" required>
                    <option value="true" <%= ordinador.disponible ? "selected" : "" %>>Disponible</option>
                    <option value="false" <%= ordinador.disponible ? "" : "selected" %>>No disponible</option>
                </select>

                <button type="submit">Desar canvis</button>
            </form>
            <a href="/ordinadors">Tornar al llistat</a>
        </section>
    </main>
</body>
</html>
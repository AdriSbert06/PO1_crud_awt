<!DOCTYPE html>
<html lang="ca">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ordinadors</title>

    <link rel="stylesheet" href="/styles.css">
</head>

<body>

    <main class="productes-llista">

        <h1>Ordinadors</h1>

        <ul>
            <% ordinadors.forEach(ordinador => { %>

                <li>
                    <div class="producte-info">

                        <h2>
                            <%= ordinador.marca %> <%= ordinador.model %>
                        </h2>

                        <p>
                            <strong>Processador:</strong>
                            <%= ordinador.processador %>
                        </p>

                        <p>
                            <strong>Memòria RAM:</strong>
                            <%= ordinador.memoriaRAM %>
                        </p>

                        <p>
                            <strong>Emmagatzematge:</strong>
                            <%= ordinador.emmagatzematge %>
                        </p>

                        <p class="preu">
                            <strong>Preu:</strong>
                            <%= ordinador.preu %> €
                        </p>

                        <p>
                            <strong>Disponibilitat:</strong>

                            <% if (ordinador.disponible) { %>
                                <span>Disponible</span>
                            <% } else { %>
                                <span>No disponible</span>
                            <% } %>
                        </p>

                    </div>

                    <div class="producte-accions">

                        <a href="/ordinadors">Veure</a>

                        <button type="button">
                            Editar
                        </button>

                        <button type="button" class="btn-eliminar">
                            Eliminar
                        </button>

                    </div>
                </li>

            <% }) %>
        </ul>

        <a href="/" class="tornar">Tornar</a>

    </main>

</body>
</html>